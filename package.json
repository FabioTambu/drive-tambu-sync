{
  "name": "drive-tambu",
  "version": "0.5.1",
  "private": true,
  "description": "Drive Tambu: cartelle remote come locali, con rclone e backup protetti",
  "author": "Drive Tambu fabio.tamburini.07@gmail.com",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "npm run prepare:vendor -- --platform win32 && npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run prepare:vendor -- --platform linux && npm run build && electron-builder --linux deb AppImage --x64 --publish never",
    "test": "node -r ./tests/register.cjs --test tests/*.test.cjs",
    "prepare:vendor": "node scripts/prepare-vendor.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.tamburini.drivetambu",
    "productName": "Drive Tambu",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "DriveTambu-${version}-Windows.${ext}",
      "extraResources": [
        {
          "from": "resources/vendor/win32-x64",
          "to": "vendor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Drive Tambu <fabio.tamburini.07@gmail.com>",
      "icon": "resources/icons",
      "synopsis": "Drive Tambu - gestore cartelle remote",
      "artifactName": "DriveTambu-${version}-Linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/vendor/linux-x64",
          "to": "vendor"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "fuse3",
        "openssh-client",
        "pkexec"
      ]
    },
    "afterPack": "./scripts/verify-vendor.cjs"
  }
}
